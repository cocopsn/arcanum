# ARCANUM · Canvas scraper secrets. Copy to `.env` ON THE DROPLET and fill in.
# NEVER commit the real .env. The repo's .gitignore already excludes .env*.

# n8n
N8N_ENCRYPTION_KEY=        # `openssl rand -hex 24` — fija para conservar credenciales
N8N_HOST=localhost
N8N_PROTOCOL=http

# Canvas (Tec) — la cookie de sesión completa del header Cookie del navegador.
# CANVAS_BASE_URL es el origen de tu Canvas (sin slash final).
CANVAS_BASE_URL=https://experiencia21.tec.mx
CANVAS_COOKIE=             # p.ej. "_csrf_token=...; canvas_session=...; log_session_id=..."

# Supabase — la SERVICE ROLE key (bypassa RLS; SOLO en el droplet, nunca en el cliente).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE=    # service_role JWT
ARCANUM_USER_ID=          # el uuid de auth.users del dueño (a quién pertenecen los eventos)
ARCANUM_DEVICE_ID=n8n-canvas
