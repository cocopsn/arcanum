{
  "name": "arcanum",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "node scripts/forge/books-publish.mjs && node scripts/forge/library-index.mjs && node scripts/forge/offline-index.mjs && node scripts/companion/build-index.mjs && next dev",
    "build": "node scripts/forge/books-publish.mjs && node scripts/forge/library-index.mjs && node scripts/forge/offline-index.mjs && node scripts/forge/oembed-fetch.mjs --build && node scripts/forge/youtube-import.mjs --if-key && node scripts/companion/build-index.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "node scripts/forge/books-publish.mjs && node scripts/forge/library-index.mjs && node scripts/forge/offline-index.mjs && node scripts/companion/build-index.mjs && tsc --noEmit",
    "test": "node scripts/forge/books-publish.mjs && node scripts/forge/library-index.mjs && node scripts/forge/offline-index.mjs && node scripts/companion/build-index.mjs && vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "loc": "node scripts/loc.mjs",
    "forge:publish": "node scripts/forge/books-publish.mjs",
    "forge:library-index": "node scripts/forge/library-index.mjs",
    "forge:offline-index": "node scripts/forge/offline-index.mjs",
    "forge:extract": "node scripts/forge/extract-maestro.mjs",
    "forge:derived": "node scripts/forge/derived-manifest.mjs",
    "forge:atlas": "node scripts/forge/atlas-build.mjs",
    "forge:oembed": "node scripts/forge/oembed-fetch.mjs",
    "forge:youtube": "node scripts/forge/youtube-import.mjs",
    "forge:bank-check": "node scripts/forge/bank-check.mjs",
    "forge:anticopy": "node scripts/forge/anticopy.mjs",
    "forge:budget": "node scripts/forge/budget-report.mjs",
    "forge:probe": "node scripts/forge/probe-prod.mjs",
    "companion:index": "node scripts/companion/build-index.mjs",
    "companion:budget": "node scripts/companion/budget.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@xyflow/react": "^12.11.1",
    "dexie": "^4.0.0",
    "framer-motion": "^11.0.0",
    "next": "^14.2.0",
    "node-html-parser": "^6.1.13",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.1.0",
    "react-simple-code-editor": "^0.14.1",
    "remark-gfm": "^4.0.1",
    "tiptap-markdown": "^0.8.10",
    "uuidv7": "^1.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@serwist/next": "^9.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^15.0.0",
    "postcss": "^8.4.0",
    "serwist": "^9.0.0",
    "sharp": "^0.35.2",
    "supabase": "^2.108.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
